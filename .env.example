# Tarjuman — environment variable template.
# Copy this file to `.env` and fill in your own keys. `.env` is git-ignored.

# ⚠️  PLACEHOLDERS ONLY — never put a real key in this file.
#     .env is git-ignored; THIS file is not, so anything written here is
#     intended to be shared/committed.

# OpenRouter (AI assistant — perplexity/sonar)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (speech-to-text — whisper-large-v3)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional ─────────────────────────────────────────────────────────────────
# Assistant model. perplexity/* models include live web search.
#   perplexity/sonar-pro  → deeper search, better answers
#   perplexity/sonar      → cheaper and faster, weaker answers
# Any OpenRouter model id works, but non-Perplexity models cannot search the web.
AI_MODEL=perplexity/sonar

# Timezone used to tell the assistant what time it is (IANA name).
AI_TIMEZONE=Asia/Riyadh

# ── Camera ───────────────────────────────────────────────────────────────────
# auto     → Picamera2 on a Raspberry Pi, otherwise the local webcam
# laptop   → force the built-in / USB webcam
# droidcam → phone camera over DroidCam (see IP/PORT below)
# <url>    → any MJPEG or RTSP stream, e.g. http://192.168.1.9:4747/video
#
# Tip: record the dataset and run inference with the SAME camera. A model
# trained on sharp phone frames behaves differently through a soft webcam.
CAMERA_SOURCE=auto

# For a phone over USB, the PC client (DroidCam / iVCam / Camo) creates a
# VIRTUAL WEBCAM. Find its number with `npm run cameras`, then set:
#   CAMERA_SOURCE=index:1
# This is the route for an iPhone — adb is Android-only and cannot see iOS.

# DroidCam address, as shown inside the phone app (Wi-Fi mode only).
DROIDCAM_IP=192.168.8.177
DROIDCAM_PORT=4747
# Optional: overrides IP/PORT entirely if your app uses a different path.
# DROIDCAM_URL=http://192.168.8.177:4747/video

# Android only: path to the platform-tools folder (or adb.exe itself), used by
# CAMERA_SOURCE=droidcam-usb. Avoids having to edit the system PATH.
# ADB_PATH=C:\Users\HP\Desktop\platform-tools-latest-windows
