# ── Secrets — NEVER commit ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/

# ── Rust / Tauri build output ────────────────────────────────────────────────
tarjuman/src-tauri/target/

# ── Models / datasets / generated artifacts ──────────────────────────────────
*.pkl
*.bak
confusion_matrix.png

# The ONNX model IS tracked: it is what the server actually loads, so a fresh
# clone can run the app without a training pass first. The .pkl stays out - it
# is a scikit-learn pickle, only useful for local inspection, regenerated by
# every `npm run train`, and pickles are version-fragile across machines.
*.onnx
!sign_model.onnx

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# -- Datasets -----------------------------------------------------------------
# The ACTIVE dataset is tracked, so a clone on another machine can train
# straight away - moving 19 MB by hand between two computers is exactly the
# kind of manual step that ends with the two of them silently disagreeing
# about what the data is.
#
# Everything else in data/ stays out: timestamped backups and superseded
# versions are large, never read by any code, and would be committed again in
# full on every snapshot.
data/*.csv
!data/learn.csv
!data/dynamic_gestures_v4.csv

# Backups and retired dataset versions - local safety copies, not shared state.
data/*.before-*.csv
data/dynamic_gestures.csv
data/dynamic_gestures_v2.csv
data/dynamic_gestures_v3.csv
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
